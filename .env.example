# Supabase (copy these into a `.env.local` file for local dev, or add in Netlify env vars)
# NOTE: `.env.example` is a template — keep placeholder values here, never real secrets.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Hidden admin route path (defaults to "nq-admin-x7k3" if unset)
# Visit https://your-site.netlify.app/#<VALUE>
VITE_ADMIN_PATH=nq-admin-x7k3

# Seed script only (service role key — NEVER commit or expose in the browser)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
